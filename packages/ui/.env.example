# Environment variables for packages/ui.
# Copy to .env.local for local development:  cp .env.example .env.local
# None of these hold secrets. Do not put credentials in this file.

# Base URL the frontend uses for API calls.
#   /api                   -> same-origin calls handled by the Next.js rewrite
#                             in next.config.ts (recommended; no CORS needed).
#   http://localhost:8080  -> call the backend directly from the browser. The
#                             backend must allow this origin in ALLOWED_ORIGINS.
# It is inlined into the browser bundle at build time. On the server, a
# relative value is ignored in favour of BACKEND_HOST / BACKEND_URL below.
# If unset, the default is http://localhost:8080.
NEXT_PUBLIC_API_URL=/api

# Full URL of the backend. Used server-side only: as the destination of the
# /api rewrite in next.config.ts, and by server components that fetch data.
# Use the Docker service name under docker compose (http://backend:8080).
# Ignored when BACKEND_HOST is set. Default: http://localhost:8080
BACKEND_URL=http://localhost:8080

# Bare hostname of the backend, with no protocol (for example
# stellar-fee-tracker-api.onrender.com). Render supplies this. https:// is
# prepended. Takes precedence over BACKEND_URL. Leave unset for local dev.
# BACKEND_HOST=
